# development | production | testing
APP_ENV=development
# Bắt buộc đổi trên production: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too

# Local: bỏ trống -> dùng SQLite tại instance/voca.db
# Production (Turso): Vercel integration tự đặt 2 biến dưới
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Hoặc chỉ định trực tiếp SQLAlchemy URL (ghi đè các biến trên)
DATABASE_URL=

LOG_LEVEL=INFO
# memory:// (mặc định) hoặc redis://... để rate limit dùng chung giữa các instance
RATELIMIT_STORAGE_URI=memory://
